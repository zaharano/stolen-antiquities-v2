# Copy to .env.local to override. All optional.

# Base map style (Stadia Maps). One of: alidade_smooth (default), stamen_toner_lite, stamen_watercolor
VITE_MAP_STYLE=alidade_smooth

# Only needed where Stadia domain auth can't be used. It ships in the client
# bundle, so prefer registering the site's domain in the Stadia dashboard instead.
VITE_STADIA_API_KEY=
